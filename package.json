{
  "version": "0.7.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kamaalio/kamaal-ts"
  },
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "bootstrap:ci": "sh scripts/bootstrap-ci.sh",
    "build": "tsc",
    "test": "vitest run",
    "lint": "prettier --check . && eslint src/index.ts src/**/*.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "release": "sh scripts/publish.sh",
    "type-check": "tsc --noEmit",
    "quality": "pnpm lint && pnpm type-check"
  },
  "name": "@kamaalio/kamaal",
  "author": "Kamaal Farah",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "resolutions": {},
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
